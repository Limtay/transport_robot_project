# ---- STM32CubeIDE 빌드 산출물 ----
stm_ws/ECU_V3/Debug/
stm_ws/ECU_V3/Release/
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.list
*.su

# ============================================
# orin_ws : ROS2(colcon) 빌드 산출물 제외, src 만 추적
# ============================================
orin_ws/build/
orin_ws/install/
orin_ws/log/

# colcon 을 워크스페이스 밖(레포 루트·패키지 안)에서 돌렸을 때 생기는 산출물도 제외.
# 2026-07-28: 실제로 세 곳에 생겨서 커밋에 딸려갈 뻔했다.
/build/
/install/
/log/
**/src/*/build/
**/src/*/install/
**/src/*/log/

# ---- 견인력 매핑 테스트 rosbag (test_index.csv 로 관리, 데이터는 로컬 보관) ----
orin_ws/TEST*_*/

# ---- 분석 파이프라인 생성 산출물 ----
analysis/traction/out/
data/

