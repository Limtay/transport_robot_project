# RViz2 설정 — dpy_camera 가 찍은 사진을 **한 장씩** 본다.
#
#     rviz2 -d src/dpy_camera/config/dpy_camera.rviz
#
# ## 쓰는 법 — 토픽 이름 끝의 숫자만 바꾼다
#
# Image 디스플레이는 **하나뿐이다.** 왼쪽 Displays 패널에서
#
#     Shot > Topic > Value : /dpy_camera/image_raw_1
#                                                 ↑ 이 숫자만 2, 3, ... 으로 바꾼다
#
# 바꾸는 즉시 그 장이 화면에 뜬다 (래치라 촬영이 한참 지나도 그대로 남아 있다).
# 번호는 **1-base** — num_shots=3 이면 `_1`, `_2`, `_3` 이다.
#
# 여러 장을 한 화면에 늘어놓지 않는 이유: 1920x1080 을 3장 쌓으면 장당 세로가
# 1/3 로 줄어 정작 사진을 못 본다. 한 장을 크게 띄우고 숫자만 바꾸는 쪽이 낫다.
#
# ## 왜 이 파일이 필요한가
#
# 사진 토픽은 **TRANSIENT_LOCAL(래치)** 로 발행된다. 그걸 받으려면 구독자도
# TRANSIENT_LOCAL 로 붙어야 하는데, `rqt_image_view` 는 그 설정이 불가능해서 화면이
# 비어 있다 (CAMERA_ACTION.md §14). **RViz2 는 Display 마다 QoS 를 지정할 수 있어서**
# 아래 `Durability Policy: Transient Local` 한 줄로 해결된다 — 촬영이 한참 지난 뒤에
# RViz 를 띄워도 사진이 나온다. 토픽 번호를 바꿔도 이 설정은 그대로 유지된다.
#
# ## Global Status 경고에 대하여
#
# TF 발행자가 없어서 `Fixed Frame` 경고가 뜬다 — **이미지 표시에는 아무 영향이 없다.**
# 이 설정은 3D 뷰를 쓰지 않는다.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Shot1
        - /Shot1/Topic1
      Splitter Ratio: 0.5
    Tree Height: 700
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Shot
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        # ↓ 이 숫자만 1 → 2 → 3 ... 으로 바꿔 가며 버스트를 훑는다
        Value: /dpy_camera/image_raw_1
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: dpy_camera_1
    Frame Rate: 30
  Name: root
  Tools: []
  Value: true
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Hide Left Dock: false
  # 도크 배치. 사진(Shot)을 창 대부분에, 그 아래 Displays(토픽 번호 바꾸는 곳)를 둔다.
  # RViz 가 `QMainWindow::saveState().toHex()` 로 저장하는 값이라 손으로 읽을 수 없다 —
  # 레이아웃을 바꾸고 싶으면 **RViz 에서 끌어 맞춘 뒤 `File > Save Config`** 로 덮어쓸 것.
  # (이 값이 없으면 Shot 패널이 250px 짜리로 뜨고 안 쓰는 3D 뷰가 화면을 다 차지한다.)
  QMainWindow State: 000000ff00000000fd00000001000000000000049c000003e8fc0200000002fb0000000800530068006f00740100000000000002bf0000001700fffffffb000000100044006900730070006c00610079007301000002c5000001230000001700ffffff0000019e000003e800000004000000040000000800000008fc00000000
  Shot:
    collapsed: false
  Width: 1600
  X: 40
  Y: 40
