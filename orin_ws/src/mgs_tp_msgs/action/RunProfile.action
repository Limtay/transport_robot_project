# 프로파일 재생 액션 (redesign/03 §5.2) — /carrier/control/run_profile
# goal 수락 시: YAML 파싱 -> 검증 -> 전 구간 사전 샘플링(200Hz 배열) -> RUNNING 전이.
# 검증 실패 시 즉시 reject. RUNNING 중 새 goal 도 reject (동시 goal 불가).
# cancel -> 즉시 안전값 -> IDLE (success=false, "canceled").
# Goal
string name                 # 실험 라벨 (피드백 goal_id 와 함께 기록)
string profile_yaml         # 프로파일 YAML 전문 — 파싱·검증은 bridge
---
# Result
bool success
string message              # 거부/중단 사유 (YAML 오류 위치 포함)
uint32 goal_id              # 피드백 토픽에 태그된 id
uint32 ticks_executed
uint32 write_err_cnt        # RW write 거부 횟수
uint32 clamp_cnt            # 클램프 발동 횟수

# ── result.json schema v2 가 요구하는 "브리지만 아는 값" (05 §5.3) ──────────────
# CLI 는 이것들을 만들어낼 수 없다. 2026-07-28 부터 실제로 채워 보낸다
# (그전까지는 정의만 있고 전부 0 이었다 — 06 F2).
#
# **카운터는 런 구간의 증분이다.** 노드 기동 이후 누적을 그대로 실으면 두 번째 런부터
# 이전 런의 사고가 섞여 들어와 그 런을 잘못 판정하게 된다.
# ── tick 이 "온전하지 않았다" 를 세는 셋. 서로 겹치지 않는다 ────────────────────
#   irregular : 정규 RW 를 **못 했다** (자리를 뺏겼다)  → 시계열에 구멍
#   late      : 정규 RW 를 했는데 **늦었다**            → 시간축이 늘어남
#   drop      : 정규 RW 를 제때 했는데 **기록을 놓쳤다** → 기록에만 구멍
uint32 irregular_tick_cnt   # out-of-span 단발·사용자 슬롯 양보로 대체된 tick 수 (기대 0)
uint32 drop_cnt             # 발행 큐 드롭 (기대 0) — 시계열에 구멍이 있었는지의 유일한 단서
uint32 late_tick_cnt        # 주기(5ms)를 넘겨 **위상이 리셋된** tick 수 (기대 0).
                            #   ⚠ tick 번호는 건너뛰지 않는다 — 루프는 따라잡지 않고 시간축을
                            #   뒤로 민다. 프로파일 시각은 여전히 tick*5ms 라, 이 값이 크면
                            #   기록된 t 와 실제 경과가 그만큼 벌어진 것이다.
                            #   (종전 이름 missing_tick_cnt — 생산자가 없어 항상 0 이었다.
                            #    "빠진 tick" 은 이 루프에서 원리적으로 생기지 않는다)
uint8  mode                 # 해석된 실효 mode (0=current 1=velocity 2=position — 05 §2.3)
uint64 seed                 # **실효 시드.** `seed:` 미지정이면 시각 기반으로 정해지는데
                            #   여기 안 실으면 noise/prbs 파형을 두 번 다시 만들 수 없다.
                            #   uint32 로는 시각 기반 값이 잘리므로 uint64 다.
bool   clock_converged      # 재생 **내내** 수렴 상태였는가. false 면 header.stamp 가
                            #   Orin 수신 시각 fallback 이라 시간축 등급이 다르다 (05 §5.2 B1)
float32 drift_ppm           # 종료 시점 드리프트 추정 (참고값)
uint32 slew_exempt_ticks    # E3 — slew 검사를 건너뛴 tick 수 (= noise 구간 길이).
                            #   그 구간은 레이트 제한이 없었다는 사실을 분석이 알아야 한다.
string run_dir              # 기록 폴더 — **CLI 가 채운다.** 브리지는 폴더를 모른다
---
# Feedback (5Hz)
float32 t                   # 프로파일 경과 [s]
uint16 segment_index
float32 progress            # 0~1
