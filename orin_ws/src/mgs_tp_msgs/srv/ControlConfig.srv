# control 런타임 설정 (redesign/03 §6.4) — /carrier/control/config
# 구 TestbedConfig. 단발 입력 2경로(01 §6.2): in-span = tick 섀도우 반영 /
# out-of-span = IDLE tick 대체.
# RUNNING/STREAM 중 호출은 거부 (실험 오염 방지) — REARM·GET_STATUS 제외.
uint8 OP_SET_ACTIVE_MOTORS = 0   # motor_mask(reg192) 재기록 — out-of-span, IDLE 만
uint8 OP_SET_CTR_MODE      = 1   # 모터별 제어 모드 — in-span (비활성 모터 지정 시 거부)
uint8 OP_SET_MODE          = 2   # ECU AUTO(1)/MANUAL(0) 전환 (reg190) — out-of-span, IDLE 만
uint8 OP_REARM             = 3   # LOCKED -> IDLE
uint8 OP_GET_STATUS        = 4   # 현재 상태 조회 (부작용 없음)
uint8 OP_SET_AUTO_MODE     = 5   # ECU auto_mode(reg188). 성공 시 write 범위가 01 §3 표대로
                                 #   자동 전환 (범위 확장 시 shadow 소독 선행)
# ── 신규 (2026-07-27) ────────────────────────────────────────
uint8 OP_SET_READ_PRESET   = 6   # 읽기 프리셋 교체 (04 §2.4.2). 브리지 내부 상태 —
                                 #   "정기 센서 변경 = 프리셋 교체" 라는 규칙의 진입점
uint8 OP_SET_STREAM_ARM    = 7   # 웹 run/stop. STREAM 진입 게이트 (01 §6.1.3).
                                 #   IDLE 에서만 on 가능. 스테일 시 자동 off
uint8 OP_GET_REGISTERS     = 9   # 레지스터 섀도 덤프 + **신선도** (07 §2 Tab3). 부작용 없음.
                                 #   value = target_id (0 이면 ECU). 응답 message 는 정형 JSON:
                                 #     {"target","total","bytes"(hex),"fresh":[[addr,len]..],
                                 #      "read_age_s","preset"}
                                 #   ⚠ `fresh` 가 이 응답의 핵심이다. 섀도는 언제나 값을 갖고
                                 #     있어서, 그것 없이 그리면 **한 번도 읽은 적 없는 자리의 0 이
                                 #     방금 읽은 값처럼 보인다**. 안 읽는 자리는 회색으로 그릴 것.
uint8 OP_SET_ORIGIN        = 8   # in-span 1회성 펄스 (01 §6.3 C-1). auto_mode=DIRECT + safe_stop.
                                 #   ⚠ 03 §6.4 는 "7 op" 로 적었고 SET_ORIGIN 을 커맨드 슬롯에
                                 #   두었으나, 01 §6.3 C-1 이 control 에서도 필요하다고 정하면서
                                 #   두 문서가 어긋났다. control 은 슬롯이 0개라(04 §2.4.1)
                                 #   CommandSet 경로가 없으므로 여기 두는 것 외에 방법이 없다.

uint8 op                    # 위 OP_* 상수
uint8[] motors              # 대상 모터 번호 (1~4) — SET_ACTIVE_MOTORS / SET_CTR_MODE
int32 value                 # op 별 의미: SET_CTR_MODE=ctr_mode(0~4) / SET_MODE=0,1
                            #   SET_AUTO_MODE=0~5 / SET_READ_PRESET=프리셋 id
                            #   SET_STREAM_ARM=0(off),1(on)
---
bool ok
string message              # read-back 결과 or 실패 사유 ("RUNNING 중 거부" 포함)
